# Copy to .env and fill in. Every setting in src/dailyainotes/settings.py is listed here.

# One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# SQLAlchemy URL with the psycopg 3 driver. This one matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://dan:dan@localhost:5432/dailyainotes

# Optional. A GitHub token with no scopes raises the API limit from 60 to 5,000 requests an hour.
GITHUB_TOKEN=

# Where the local embedding model (64 MB) is downloaded the first time it is used.
EMBEDDING_CACHE_DIR=.cache/fastembed

# Model providers, free plans. A provider without a key is skipped by the router.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OPENROUTER_API_KEY=
# Ollama does not publish its free credits; the router stops at this many tokens a day.
OLLAMA_DAILY_TOKEN_BUDGET=600000

# Model chain per role: provider:model pairs, tried in order (INTENT.md, LLM router).
LLM_PLANNER=ollama:gpt-oss:120b,openrouter:google/gemma-4-31b-it:free
LLM_RESEARCHER=ollama:gpt-oss:120b,openrouter:google/gemma-4-31b-it:free
LLM_WRITER=ollama:gpt-oss:120b,openrouter:google/gemma-4-31b-it:free
LLM_EXTRACTOR=ollama:gpt-oss:20b,openrouter:google/gemma-4-31b-it:free
# Another model family than the Writer's, so it does not share the Writer's mistakes.
LLM_VERIFIER=ollama:gemma4:31b,openrouter:google/gemma-4-31b-it:free
# Ollama only: OpenRouter's free requests go to the pipeline.
LLM_ASK=ollama:gpt-oss:120b
# The nightly eval's judge, from another family than the models it judges.
LLM_JUDGE=ollama:gemma4:31b

# Cloudflare Access in front of /admin (ADR 0003): the team domain (<team>.cloudflareaccess.com)
# and the Access application's AUD tag. Admin is off while either is empty; use `dan review`.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# The site's own address: links in sign-in emails, and the origin that requests changing a
# reader's data must come from. Compose sets it in production.
SITE_URL=http://localhost:4321

# Reader sign-in (ADR 0003). Resend sends the code (free plan: 100 emails a day), from an address
# on a domain verified in Resend. Sign-in is off while the key is empty.
RESEND_API_KEY=
EMAIL_FROM=Daily AI Notes <sign-in@dailyainotes.com>
# Cloudflare Turnstile on the sign-in form. Without the secret, the form has no bot check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Keys the hash of a visitor's IP for Ask's rate limits (openssl rand -hex 32). Without it,
# the API makes a random key at start and the limits reset when it restarts.
IP_HASH_KEY=

# The deployed commit, kept with eval runs. Compose sets it in production; leave it empty here.
GIT_SHA=

# Langfuse Cloud tracing. Leave the keys empty to turn tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
