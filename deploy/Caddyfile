# Plain HTTP inside Docker: only cloudflared reaches Caddy, and Cloudflare holds the certificate
# (ADR 0002). DOMAIN comes from the server's .env.

# Request headers carry the visitor's address (CF-Connecting-IP, X-Forwarded-For), and logs never
# keep raw IPs (INTENT.md). This logger takes Caddy's own and error lines; the site's log below
# takes the access lines. remote_ip is cloudflared's container.
{
	log default {
		format filter {
			request>headers delete
			wrap json
		}
	}
}

http://{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# CF-Connecting-IP is the address that connected to Cloudflare. X-Forwarded-For keeps
			# whatever a visitor sent and appends to it, so its first entry can be forged.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle {
		reverse_proxy web:4321
	}

	log {
		output stdout
		# Without request headers, as in the default logger above.
		format filter {
			request>headers delete
			wrap json
		}
	}
}

http://www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
