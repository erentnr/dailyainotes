---
import { Font } from "astro:assets";
import { SITE_AUTHOR_NAME, SITE_AUTHOR_URL, SITE_SOURCE_URL } from "astro:env/server";

import { AskIcon, CodeIcon, External, GitHubMark, TodayIcon, TopicsIcon, YouIcon } from "../components/ui/Icons";
import { Logo } from "../components/ui/Logo";
import ThemeToggle from "../islands/ThemeToggle";
import { footerLinks } from "../lib/footer";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** The note page draws its own top on a phone: the cover, with buttons over it. */
  coverTop?: boolean;
  /** The topic picker has its own bar at the bottom of a phone instead of the tab bar. */
  tabBar?: boolean;
}

const {
  title,
  description = "AI takes notes on what's happening, every day, on the things you care about.",
  coverTop = false,
  tabBar = true,
} = Astro.props;
const path = Astro.url.pathname;
const reader = Astro.locals.reader;
const you = reader ? "/account" : "/sign-in";
const nav = [
  ["/", "Today"],
  ["/topics", "Topics"],
  ["/ask", "Ask"],
  ["/how-it-works", "How it works"],
] as const;
const links = footerLinks({
  sourceUrl: SITE_SOURCE_URL,
  authorName: SITE_AUTHOR_NAME,
  authorUrl: SITE_AUTHOR_URL,
});
const current = (href: string) =>
  (href === "/" ? path === "/" || path.startsWith("/day/") : path.startsWith(href)) ? "page" : undefined;
const tabs = [
  ["/", "Today", TodayIcon],
  ["/topics", "Topics", TopicsIcon],
  ["/ask", "Ask", AskIcon],
  [you, "You", YouIcon],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Daily AI Notes" ? title : `${title} · Daily AI Notes`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      // Before the first paint, so the dark theme never flashes light.
      const saved = localStorage.getItem("dan.theme");
      const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", dark);
    </script>
    {
      reader && (
        <script is:inline define:vars={{ topics: reader.topics }}>
          // A signed-in reader's topics come from the account, before any island reads them.
          localStorage.setItem("dan.topics", JSON.stringify(topics));
        </script>
      )
    }
  </head>
  <body class:list={{ "cover-top": coverTop, "own-bottom-bar": !tabBar }}>
    <header class="site-header">
      <Logo />
      <nav class="pill-nav" aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
      </nav>
      <div class="header-end">
        <ThemeToggle client:load />
        {
          reader ? (
            <a class="avatar" href="/account" aria-label="Your account" aria-current={current("/account")}>
              {reader.email.slice(0, 1).toUpperCase()}
            </a>
          ) : (
            <a class="sign-in-link" href="/sign-in" aria-current={current("/sign-in")}>
              Sign in
            </a>
          )
        }
      </div>
    </header>
    <main class="page">
      <slot />
      <footer class="site-footer">
        <Logo />
        <nav class="footer-links" aria-label="Footer">
          <a href="/how-it-works">How it works</a>
          <a href="/privacy">Privacy</a>
          {
            links.map(({ href, label, icon }) => (
              <a href={href} rel="noopener">
                {icon === "github" && <GitHubMark />}
                {icon === "code" && <CodeIcon />}
                {label}
                <External />
              </a>
            ))
          }
        </nav>
      </footer>
    </main>
    {
      tabBar && (
        <nav class="tab-bar" aria-label="Main">
          {tabs.map(([href, label, Icon]) => (
            <a href={href} aria-current={current(href)}>
              <Icon />
              {label}
            </a>
          ))}
        </nav>
      )
    }
  </body>
</html>
