---
import NoteView from "../../islands/NoteView";
import Base from "../../layouts/Base.astro";
import { serverApi } from "../../lib/api/server";

const api = serverApi();
const { data: note, response } = await api.GET("/api/v1/notes/{slug}", {
  params: { path: { slug: Astro.params.slug ?? "" } },
});
if (!note) {
  if (response.status === 404) return Astro.rewrite("/404");
  throw new Error(`The API answered ${response.status}`);
}
const reader = Astro.locals.reader;
const [topics, earlier, day] = await Promise.all([
  api.GET("/api/v1/topics"),
  api.GET("/api/v1/topics/{slug}/notes", {
    params: { path: { slug: note.topic }, query: { before: note.edition_date, limit: 3 } },
  }),
  api.GET("/api/v1/notes", { params: { query: { date: note.edition_date } } }),
]);
---

<Base title={note.title} description={note.summary} coverTop>
  <NoteView
    client:load
    note={note}
    topics={topics.data ?? []}
    context={earlier.data?.notes ?? []}
    day={day.data?.notes ?? []}
    readerTopics={reader?.topics ?? null}
  />
</Base>
