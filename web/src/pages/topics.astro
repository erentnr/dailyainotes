---
import { ErrorState } from "../components/ui/States";
import TopicPicker from "../islands/TopicPicker";
import Base from "../layouts/Base.astro";
import { serverApi } from "../lib/api/server";

const api = serverApi();
const [{ data: topics }, { data: options }] = await Promise.all([
  api.GET("/api/v1/topics"),
  api.GET("/api/v1/auth/options"),
]);
const signedIn = Astro.locals.reader !== null;
---

<Base title="Your topics" tabBar={false}>
  {
    topics ? (
      <TopicPicker client:load topics={topics} signedIn={signedIn} twoSteps={!signedIn && Boolean(options?.sign_in)} />
    ) : (
      <ErrorState>The catalog could not be loaded.</ErrorState>
    )
  }
  {
    topics && (
      <section class="section timelines" aria-labelledby="timelines-title">
        <h2 class="section-title" id="timelines-title">Every note on a topic</h2>
        <div class="chips">
          {topics.map((t) => <a class="chip" href={`/topics/${t.slug}`}>{t.name}</a>)}
        </div>
      </section>
    )
  }
</Base>
