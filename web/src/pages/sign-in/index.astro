---
import { EmptyState } from "../../components/ui/States";
import SignIn from "../../islands/SignIn";
import Base from "../../layouts/Base.astro";
import { safeNext } from "../../lib/account";
import { serverApi } from "../../lib/api/server";

const next = safeNext(Astro.url.searchParams.get("next"));
// The topic picker's second step: optional, so it can be skipped.
const stepTwo = Astro.url.searchParams.get("step") === "2";
if (Astro.locals.reader) return Astro.redirect(next === "/" ? "/account" : next);
const { data: options } = await serverApi().GET("/api/v1/auth/options");
---

<Base title="Sign in">
  <header class="page-head">
    {
      stepTwo ? (
        <div class="steps">
          <span class="meta">STEP 2 OF 2</span>
          <span class="steps-bar" aria-hidden="true">
            <span class="is-done" />
            <span class="is-done" />
          </span>
        </div>
      ) : (
        <div class="label">Account</div>
      )
    }
    <h1 class="h1">{stepTwo ? "Keep your topics on every device" : "Sign in"}</h1>
  </header>
  <p class="measure muted">
    No password: we email you a code. An account keeps your topics on every device and lets you
    suggest topics, and you need one to ask the notes. Reading works without one.
  </p>
  {
    options?.sign_in ? (
      <SignIn client:load siteKey={options.turnstile_site_key} next={next} />
    ) : (
      <EmptyState>Sign-in is not open yet. Everything else works without an account.</EmptyState>
    )
  }
  {
    stepTwo && (
      <p class="section">
        <a class="button button-secondary" href={next}>Not now: read your page</a>
      </p>
    )
  }
  <p class="small muted measure section">
    What we keep and why is on the <a href="/privacy">privacy page</a>.
  </p>
</Base>
