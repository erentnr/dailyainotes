{
 "openapi": "3.1.0",
 "info": {
  "title": "Daily AI Notes",
  "version": "0.1.0"
 },
 "paths": {
  "/api/v1/health": {
   "get": {
    "summary": "Health",
    "operationId": "health_api_v1_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/ask": {
   "post": {
    "summary": "Ask The Notes",
    "description": "Only for a signed-in reader (ADR 0004).",
    "operationId": "ask_the_notes_api_v1_ask_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Question"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "401": {
      "description": "Not signed in"
     },
     "429": {
      "description": "Over a day's limit"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/me/questions": {
   "get": {
    "summary": "My Questions",
    "description": "The reader's own questions to Ask from the last 30 days, newest first.",
    "operationId": "my_questions_api_v1_me_questions_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/AskedQuestion"
         },
         "type": "array",
         "title": "Response My Questions Api V1 Me Questions Get"
        }
       }
      }
     },
     "401": {
      "description": "Unauthorized"
     }
    }
   }
  },
  "/api/v1/topics": {
   "get": {
    "summary": "Topics",
    "operationId": "topics_api_v1_topics_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Topic"
         },
         "type": "array",
         "title": "Response Topics Api V1 Topics Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/notes": {
   "get": {
    "summary": "Notes Of Day",
    "operationId": "notes_of_day_api_v1_notes_get",
    "parameters": [
     {
      "name": "topic",
      "in": "query",
      "required": false,
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "maxItems": 20,
       "default": [],
       "title": "Topic"
      }
     },
     {
      "name": "date",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "date"
        },
        {
         "type": "null"
        }
       ],
       "title": "Date"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Day"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/me/notes/{slug}/feedback": {
   "get": {
    "summary": "Get Feedback",
    "operationId": "get_feedback_api_v1_me_notes__slug__feedback_get",
    "parameters": [
     {
      "name": "slug",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Slug"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Feedback"
        }
       }
      }
     },
     "401": {
      "description": "Unauthorized"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "put": {
    "summary": "Put Feedback",
    "description": "A reader's \"more like this\" or \"less like this\" on a note, kept with the account.",
    "operationId": "put_feedback_api_v1_me_notes__slug__feedback_put",
    "parameters": [
     {
      "name": "slug",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Slug"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Feedback"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Feedback"
        }
       }
      }
     },
     "401": {
      "description": "Unauthorized"
     },
     "404": {
      "description": "No published note"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/notes/{slug}": {
   "get": {
    "summary": "Note",
    "operationId": "note_api_v1_notes__slug__get",
    "parameters": [
     {
      "name": "slug",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Slug"
