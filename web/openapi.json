     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/NoteDetail"
        }
       }
      }
     },
     "404": {
      "description": "No published note"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/topics/{slug}/notes": {
   "get": {
    "summary": "Timeline",
    "operationId": "timeline_api_v1_topics__slug__notes_get",
    "parameters": [
     {
      "name": "slug",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Slug"
      }
     },
     {
      "name": "before",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "date"
        },
        {
         "type": "null"
        }
       ],
       "title": "Before"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 100,
       "minimum": 1,
       "default": 30,
       "title": "Limit"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Timeline"
        }
       }
      }
     },
     "404": {
      "description": "No active topic"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/stats": {
   "get": {
    "summary": "Stats",
    "operationId": "stats_api_v1_stats_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Stats"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/auth/options": {
   "get": {
    "summary": "Options",
    "operationId": "options_api_v1_auth_options_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Options"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/auth/code": {
   "post": {
    "summary": "Request Code",
    "operationId": "request_code_api_v1_auth_code_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CodeRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "202": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": {
          "type": "boolean"
         },
         "type": "object",
         "title": "Response Request Code Api V1 Auth Code Post"
        }
       }
      }
     },
     "400": {
      "description": "Not an email, or the bot check failed"
     },
     "429": {
      "description": "Too many codes"
     },
     "502": {
      "description": "The email could not be sent"
     },
     "503": {
      "description": "Sign-in is off"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/auth/verify": {
   "post": {
    "summary": "Verify Code",
    "operationId": "verify_code_api_v1_auth_verify_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CodeSignIn"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Me"
        }
       }
      }
     },
     "400": {
      "description": "Not an email, or a wrong, used or expired code"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/auth/link": {
   "post": {
    "summary": "Verify Link",
    "operationId": "verify_link_api_v1_auth_link_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/LinkSignIn"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Me"
        }
       }
      }
     },
     "400": {
      "description": "Used or expired link"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/auth/sign-out": {
   "post": {
    "summary": "End Session",
    "operationId": "end_session_api_v1_auth_sign_out_post",
    "responses": {
     "204": {
      "description": "Successful Response"
     }
    }
   }
  },
  "/api/v1/me": {
   "get": {
    "summary": "Me",
    "description": "The signed-in reader's account, or null when no one is signed in.",
    "operationId": "me_api_v1_me_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "anyOf": [
          {
           "$ref": "#/components/schemas/Me"
          },
          {
           "type": "null"
          }
         ],
         "title": "Response Me Api V1 Me Get"
        }
       }
      }
     }
    }
   },
   "delete": {
    "summary": "Delete Me",
    "operationId": "delete_me_api_v1_me_delete",
    "responses": {
     "204": {
      "description": "Successful Response"
     },
     "401": {
      "description": "Unauthorized"
     }
    }
   }
  },
  "/api/v1/me/topics": {
   "put": {
    "summary": "Set Topics",
    "operationId": "set_topics_api_v1_me_topics_put",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Topics"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Me"
        }
       }
      }
     },
     "400": {
      "description": "Too many topics, or one twice"
     },
     "401": {
      "description": "Unauthorized"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/me/suggestions": {
   "post": {
    "summary": "Suggest Topic",
    "description": "Add a topic (ADR 0006): planned at once, unless an existing topic covers it.",
    "operationId": "suggest_topic_api_v1_me_suggestions_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/NewSuggestion"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Me"
        }
       }
      }
     },
     "400": {
      "description": "Too many being planned, or today's new topics are used up"
     },
     "401": {
      "description": "Unauthorized"
     },
     "409": {
      "description": "An existing topic covers it",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Covered"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/admin/me": {
   "get": {
    "summary": "Me",
    "operationId": "me_api_v1_admin_me_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SignedInEditor"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/admin/notes": {
   "get": {
    "summary": "Waiting",
    "operationId": "waiting_api_v1_admin_notes_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Review"
         },
         "type": "array",
         "title": "Response Waiting Api V1 Admin Notes Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/admin/notes/{note_id}/decision": {
   "post": {
    "summary": "Decide",
    "operationId": "decide_api_v1_admin_notes__note_id__decision_post",
    "parameters": [
     {
      "name": "note_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Note Id"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Decision"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": {
          "type": "string"
         },
         "title": "Response Decide Api V1 Admin Notes  Note Id  Decision Post"
        }
       }
      }
     },
     "409": {
      "description": "Not waiting"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/admin/plans": {
   "get": {
    "summary": "Plans",
    "description": "Topic plans waiting for review.",
    "operationId": "plans_api_v1_admin_plans_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Plan"
         },
         "type": "array",
         "title": "Response Plans Api V1 Admin Plans Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/admin/plans/{plan_id}/decision": {
   "post": {
    "summary": "Decide On Plan",
    "description": "Approving adds the plan's sources and makes the topic active.",
    "operationId": "decide_on_plan_api_v1_admin_plans__plan_id__decision_post",
    "parameters": [
     {
      "name": "plan_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Plan Id"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PlanDecision"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": {
          "type": "string"
         },
         "title": "Response Decide On Plan Api V1 Admin Plans  Plan Id  Decision Post"
        }
       }
      }
     },
     "409": {
      "description": "Not waiting, or approving a plan without sources"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "AskedQuestion": {
    "properties": {
     "question": {
      "type": "string",
      "title": "Question"
     },
     "asked_at": {
      "type": "string",
      "format": "date-time",
      "title": "Asked At"
     },
     "answered": {
      "type": "boolean",
      "title": "Answered"
     },
     "notes": {
      "items": {
       "$ref": "#/components/schemas/CitedNote"
      },
      "type": "array",
      "title": "Notes"
     }
    },
    "type": "object",
    "required": [
     "question",
     "asked_at",
     "answered",
     "notes"
    ],
    "title": "AskedQuestion"
   },
   "CitedNote": {
    "properties": {
     "slug": {
      "type": "string",
      "title": "Slug"
     },
     "title": {
      "type": "string",
      "title": "Title"
     }
    },
    "type": "object",
    "required": [
     "slug",
     "title"
    ],
    "title": "CitedNote"
   },
   "Claim": {
    "properties": {
     "text": {
      "type": "string",
      "title": "Text"
     },
     "kind": {
      "type": "string",
      "title": "Kind"
     },
     "markers": {
      "items": {
       "type": "integer"
      },
      "type": "array",
      "title": "Markers"
     },
     "verdict": {
      "type": "string",
      "title": "Verdict"
     },
     "independent_origins": {
      "type": "integer",
      "title": "Independent Origins"
     },
     "rationale": {
      "type": "string",
      "title": "Rationale"
     }
    },
    "type": "object",
    "required": [
     "text",
     "kind",
     "markers",
     "verdict",
     "independent_origins",
     "rationale"
    ],
    "title": "Claim"
   },
   "CodeRequest": {
    "properties": {
     "email": {
      "type": "string",
      "maxLength": 254,
      "title": "Email"
     },
     "bot_token": {
      "type": "string",
      "maxLength": 2048,
      "title": "Bot Token",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "email"
    ],
    "title": "CodeRequest"
   },
   "CodeSignIn": {
    "properties": {
     "email": {
      "type": "string",
      "maxLength": 254,
      "title": "Email"
     },
     "code": {
      "type": "string",
      "pattern": "^\\s*\\d{6}\\s*$",
      "title": "Code"
     }
    },
    "type": "object",
    "required": [
     "email",
     "code"
    ],
    "title": "CodeSignIn"
   },
   "Covered": {
    "properties": {
     "detail": {
      "$ref": "#/components/schemas/CoveredBy"
     }
    },
    "type": "object",
    "required": [
     "detail"
    ],
    "title": "Covered"
   },
   "CoveredBy": {
    "properties": {
     "message": {
      "type": "string",
      "title": "Message"
     },
     "slug": {
      "type": "string",
      "title": "Slug"
     },
     "name": {
      "type": "string",
      "title": "Name"
     }
    },
    "type": "object",
    "required": [
     "message",
     "slug",
     "name"
    ],
